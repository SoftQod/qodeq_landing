    "/deposit": {
      "get": {
        "summary": "Deposit",
        "description": "Returns the list of last `limit` deposits for a specific player.\nDeposits should not be filtered and should be sorted by Datetime DESC (New deposits first)",
        "operationId": "deposit_deposit_get",
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "query",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ],
              "description": "User unique identifier. Can be email or user_id",
              "title": "Player Id"
            },
            "description": "User unique identifier. Can be email or user_id"
          },
          {
            "name": "start_at",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Start At"
            }
          },
          {
            "name": "end_at",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "title": "End At"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "exclusiveMaximum": 20,
              "exclusiveMinimum": 0,
              "default": 5,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "$ref": "#/components/schemas/DepositResponse"
                    },
                    {
                      "$ref": "#/components/schemas/DepositFailureResponse"
                    }
                  ],
                  "title": "Response Deposit Deposit Get"
                }
              }
            }
          },
          "404": {
            "description": "Player Not Found"
          },
          "401": {
            "description": "Unauthorized — invalid or missing API key"
          },
          "403": {
            "description": "Forbidden — insufficient permissions"
          },
          "500": {
            "description": "Internal server error"
          },
          "503": {
            "description": "Service temporarily unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
