  "paths": {
    "/wager": {
      "get": {
        "summary": "Wager",
        "description": "Returns the current wagering progress for a specific player,\nincluding the total requirement, amount already wagered, and remaining amount to complete",
        "operationId": "wager_wager_get",
        "security": [
          {
            "APIKeyCookie": []
          }
        ],
        "parameters": [
          {
            "name": "player_id",
            "in": "query",
            "required": true,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ],
              "description": "User unique identifier. Can be email or user_id",
              "title": "Player Id"
            },
            "description": "User unique identifier. Can be email or user_id"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WagerResponse"
                }
              }
            }
          },
          "404": {
            "description": "Player Not Found"
          },
          "401": {
            "description": "Unauthorized — invalid or missing API key"
          },
          "403": {
            "description": "Forbidden — insufficient permissions"
          },
          "500": {
            "description": "Internal server error"
          },
          "503": {
            "description": "Service temporarily unavailable"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
