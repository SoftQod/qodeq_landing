  "components": {
    "schemas": {
      "CashbackAlternativeBonus": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Bonus display name"
          },
          "link": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Link",
            "description": "URL to the bonus page"
          }
        },
        "type": "object",
        "required": [
          "name",
          "link"
        ],
        "title": "CashbackAlternativeBonus"
      },
      "CashbackAvailableResponse": {
        "properties": {
          "is_available": {
            "type": "boolean",
            "const": true,
            "title": "Is Available"
          },
          "amount": {
            "type": "number",
            "title": "Amount",
            "description": "Cashback amount available"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "description": "ISO 4217 currency code",
            "example": "USD"
          },
          "available_at": {
            "type": "string",
            "format": "date-time",
            "title": "Available At",
            "description": "Date and time when cashback becomes available to the player"
          }
        },
        "type": "object",
        "required": [
          "is_available",
          "amount",
          "currency",
          "available_at"
        ],
        "title": "CashbackAvailableResponse",
        "example": {
          "amount": 25.0,
          "available_at": "2026-01-01T00:00:00Z",
          "currency": "USD",
          "is_available": true
        }
      },
      "CashbackUnavailableReason": {
        "type": "string",
        "enum": [
          "insufficient_loss",
          "player_in_profit",
          "low_loyalty",
          "admin_disabled"
        ],
        "title": "CashbackUnavailableReason",
        "description": "- `insufficient_loss` — Player has not lost enough during the qualifying period\n- `player_in_profit` — Player has a net positive balance for the qualifying period\n- `low_loyalty` — Player's loyalty level does not meet the minimum requirement\n- `admin_disabled` — Cashback has been disabled by the operator"
      },
      "CashbackUnavailableResponse": {
        "properties": {
          "is_available": {
            "type": "boolean",
            "const": false,
            "title": "Is Available"
          },
          "reason": {
            "$ref": "#/components/schemas/CashbackUnavailableReason"
          },
          "required_amount": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Required Amount",
            "description": "Minimum loss amount required to qualify for cashback"
          },
          "alternative_bonus": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CashbackAlternativeBonus"
              },
              {
                "type": "null"
              }
            ],
            "description": "Alternative bonus offered if cashback is unavailable"
          }
        },
        "type": "object",
        "required": [
          "is_available",
          "reason",
          "required_amount",
          "alternative_bonus"
        ],
        "title": "CashbackUnavailableResponse",
        "example": {
          "alternative_bonus": {
            "link": "https://example.com/bonuses/free-spins",
            "name": "Free Spins"
          },
          "is_available": false,
          "reason": "insufficient_loss",
          "required_amount": 200.0
        }
      },
      "DepositFailureResponse": {
        "properties": {
          "amount": {
            "type": "number",
            "title": "Amount",
            "description": "Amount to be deposited"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "description": "ISO 4217 currency code",
            "example": "USD"
          },
          "datetime": {
            "type": "string",
            "format": "date-time",
            "title": "Datetime",
            "description": "Date and time when deposit begins"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "Deposit method. Recommended format: $1/$2, where $1 is crypto or fiat and $2 is usdt, btc for crypto or bank name for fiat",
            "example": "crypto/usdt"
          },
          "transaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Transaction Id",
            "description": "Internal transaction ID that Player can see on the project"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentReasonableResponse"
          },
          "reason": {
            "type": "string",
            "title": "Reason",
            "description": "Reason for the deposit failure"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "currency",
          "datetime",
          "method",
          "transaction_id",
          "status",
          "reason"
        ],
        "title": "DepositFailureResponse",
        "example": {
          "amount": 200.0,
          "currency": "USD",
          "datetime": "2020-01-01T20:13:56",
          "method": "fiat/imagine-bank",
          "reason": "Imaginary reason for deposit rejection",
          "status": "rejected",
          "transaction_id": "dCvs***c24sc"
        }
      },
      "DepositResponse": {
        "properties": {
          "amount": {
            "type": "number",
            "title": "Amount",
            "description": "Amount to be deposited"
          },
          "currency": {
            "type": "string",
            "maxLength": 3,
            "minLength": 3,
            "title": "Currency",
            "description": "ISO 4217 currency code",
            "example": "USD"
          },
          "datetime": {
            "type": "string",
            "format": "date-time",
            "title": "Datetime",
            "description": "Date and time when deposit begins"
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "Deposit method. Recommended format: $1/$2, where $1 is crypto or fiat and $2 is usdt, btc for crypto or bank name for fiat",
            "example": "crypto/usdt"
          },
          "transaction_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Transaction Id",
            "description": "Internal transaction ID that Player can see on the project"
          },
          "status": {
            "$ref": "#/components/schemas/PaymentStatus"
          }
        },
        "type": "object",
        "required": [
          "amount",
          "currency",
          "datetime",
          "method",
          "transaction_id",
          "status"
        ],
        "title": "DepositResponse",
        "example": {
          "amount": 200.0,
          "currency": "USD",
          "datetime": "2020-01-01T20:13:56",
          "method": "fiat/imagine-bank",
          "status": "pending",
          "transaction_id": "dCvs***c24sc"
        }
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PaymentReasonableResponse": {
        "type": "string",
        "enum": [
          "failed",
          "rejected"
        ],
        "title": "PaymentReasonableResponse",
        "description": "failed - request processing failed due to an internal error\nrejected - Operator rejected request"
      },
      "PaymentStatus": {
        "type": "string",
        "enum": [
          "open",
          "pending",
          "canceled",
          "success"
        ],
        "title": "PaymentStatus",
        "description": "open - request received but not processed yet\npending - request received and being processed\ncanceled - user canceled the request\nsuccess - request has been successfully processed"
      },
      "ProfileConfirmationResponse": {
        "properties": {
          "email": {
            "type": "boolean",
            "title": "Email",
            "description": "Whether the player's email address is confirmed"
          },
          "phone": {
            "type": "boolean",
            "title": "Phone",
            "description": "Whether the player's phone number is confirmed"
          }
        },
        "type": "object",
        "required": [
          "email",
          "phone"
        ],
        "title": "ProfileConfirmationResponse",
        "description": "Player email and phone confirmation",
        "example": {
          "email": true,
          "phone": false
        }
      },
      "TicketRequest": {
        "properties": {
          "player_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Player Id",
            "description": "User unique identifier. Can be email or user_id"
          },
          "content": {
            "type": "string",
            "title": "Content",
            "description": "Ticket content"
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "title": "Priority"
          },
          "group": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Group",
            "description": "Ticket group/team assignment"
          },
          "agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "integer"
              }
            ],
            "title": "Agent",
            "description": "Ticket group/team assignment"
          }
        },
        "type": "object",
        "required": [
          "player_id",
          "content",
          "priority"
        ],
        "title": "TicketRequest",
        "example": {
          "content": "User Ticket Request with provided url https://...",
          "group": "494d0b1c-6c54-4b0a-9e8a-8bf6d33b9cef",
          "player_id": 32131231,
          "priority": "low"
        }
      },
      "TicketResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "success",
            "title": "Status"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "TicketResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
